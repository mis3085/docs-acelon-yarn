    <item>
      <title>Soluzioni Innovative di Filati Medicali per Salute e Riabilitazione</title>
      <link>https://docs-acelon-yarn.web.app/it/applications/health-care/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://docs-acelon-yarn.web.app/it/applications/health-care/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Materiali Avanzati per Salute e Riabilitazione 
    &lt;div id=&#34;materiali-avanzati-per-salute-e-riabilitazione&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700&#34;
